# --- Основной: Gemini ---
GEMINI_API_KEY=PUT_YOUR_GEMINI_KEY_HERE  # https://aistudio.google.com/app/apikey
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# --- Фолбэк: OpenRouter (если Gemini квота; без ключа fallback отключён) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODELS=minimax/minimax-m3:free,liquid/lfm-2.5-2.6b:free
OPENROUTER_REFERER=http://localhost:8000
OPENROUTER_TITLE=Implant-Dent Demo

# --- WhatsApp Cloud API (Meta Business) ---
WHATSAPP_TOKEN=EAAG...  # Permanent access token
WHATSAPP_PHONE_NUMBER_ID=1234567890  # Phone Number ID
WHATSAPP_VERIFY_TOKEN=implant_dent_verify_7K4m9Q2x_2026  # одинаковый в Meta и здесь
WHATSAPP_APP_SECRET=abc123def456  # App Secret; в production обязателен (fail-closed)

# --- Telegram (уведомления о лидах; best-effort, не блокирует ответы) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Persistent state (опционально; без него — in-memory на 1 реплику) ---
# REDIS_URL=redis://default:pass@host:6379/0  # в Railway: Add Redis plugin

# --- Режим: development | production | test ---
APP_ENV=development
# В production startup упадёт с понятной ошибкой если нет LLM-ключа/WHATSAPP_*.

# --- HTTP ---
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=12
HTTP_POOL_MAX=20

# --- Rate limits ---
WA_RATE_LIMIT=10
WA_RATE_WINDOW_S=60
API_CHAT_RATE_LIMIT=20
API_CHAT_RATE_WINDOW_S=60

# --- CORS (для демо "*", для прода — домены клиники через запятую) ---
ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
